# Copy to .env and fill in. Never commit .env or send credentials by email.
SOURCE_DB_URL=postgresql+psycopg://YOUR_LOGIN:YOUR_PASSWORD@DB_HOST:5432/academy
TARGET_DB_URL=postgresql+psycopg://YOUR_LOGIN:YOUR_PASSWORD@DB_HOST:5432/academy
# Your group's schema for this slot, e.g. w3_g1
TARGET_SCHEMA=w3_g1
POLICYHOLDERS_CSV=data/policyholders.csv
# Provided by your trainer; the same for the whole cohort so results can be compared
PSEUDONYM_SALT=ask-your-trainer
AS_OF_DATE=2026-10-31
# Leave blank to use postcodes.io. Your trainer may give you a snapshot file if the API is down.
POSTCODES_OFFLINE_FILE=
